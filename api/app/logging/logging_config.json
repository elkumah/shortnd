{
  "version": 1,
  "disable_existing_loggers": false,

  "formatters": {
    "standard": {
      "format": "%(asctime)s %(levelname)s %(name)s %(message)s",
      "datefmt": "%Y-%m-%dT%H:%M:%S%z"
    }
  },

  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "level": "INFO",
      "formatter": "standard",
      "stream": "ext://sys.stdout"
    },

    "error_console": {
      "class": "logging.StreamHandler",
      "level": "ERROR",
      "formatter": "standard",
      "stream": "ext://sys.stderr"
    }
  },

  "loggers": {
    "app": {
      "handlers": ["console", "error_console"],
      "level": "INFO",
      "propagate": false
    },

    "uvicorn": {
      "handlers": ["console"],
      "level": "INFO",
      "propagate": false
    },

    "sqlalchemy.engine": {
      "handlers": ["console"],
      "level": "WARNING",
      "propagate": false
    }
  }
}
